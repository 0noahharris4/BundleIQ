# Copy this file to .env and fill in your own key (never commit the real
# .env -- it's already in .gitignore). Only the "Ask your data" chatbot
# needs this; every other BasketIQ feature works with no key at all.
#
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Optional: override the chat model (defaults to gpt-4o-mini).
# OPENAI_MODEL=gpt-4o-mini
